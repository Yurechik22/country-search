{
  "name": "country-search",
  "version": "1.0.0",
  "private": true,
  "description": "Live country search with debounce, request cancellation and race-condition handling",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:site": "npm run build && node scripts/build-site.mjs",
    "watch": "tsc -p tsconfig.json --watch",
    "start": "npx --yes serve .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,json,md,css,html}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vitest": "^2.1.5"
  }
}
